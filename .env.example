# ===========================================
# Self-Hosted AI Starter Kit - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# -------------------------------------------
# PostgreSQL Database
# -------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-secure-postgres-password
POSTGRES_DB=n8n

# Non-root user for n8n (created by postgres-setup)
POSTGRES_NON_ROOT_USER=n8n
POSTGRES_NON_ROOT_PASSWORD=your-secure-n8n-db-password

# -------------------------------------------
# n8n Workflow Automation
# -------------------------------------------
N8N_ENCRYPTION_KEY=your-32-char-encryption-key-here
N8N_USER_MANAGEMENT_JWT_SECRET=your-jwt-secret-here
N8N_DOMAIN=n8n.lab.home-cloud.uk

# -------------------------------------------
# Kokoro TTS
# -------------------------------------------
# GPU API base URL: https://${KOKORO_API_DOMAIN}/v1
# Web UI URL: https://${KOKORO_WEB_DOMAIN}
KOKORO_API_KEY=kokoro-local-key
KOKORO_API_DOMAIN=kokoro-api.lab.home-cloud.uk
KOKORO_WEB_DOMAIN=tts.lab.home-cloud.uk
# Optional: set this to protect kokoro-web's /api/v1 routes.
# Leave blank to disable auth on tts.<domain> while keeping kokoro-api separate.
KOKORO_WEB_API_KEY=

# -------------------------------------------
# ComfyUI
# -------------------------------------------
COMFY_DOMAIN=cui.lab.home-cloud.uk

# -------------------------------------------
# Ollama
# -------------------------------------------
OLLAMA_DOMAIN=ollama.lab.home-cloud.uk

# -------------------------------------------
# Open WebUI
# -------------------------------------------
WEBUI_DOMAIN=chat.lab.home-cloud.uk

# -------------------------------------------
# Hugging Face (for downloading gated models)
# -------------------------------------------
# Get your token from: https://huggingface.co/settings/tokens
HUGGINGFACE_TOKEN=hf_your_token_here

# -------------------------------------------
# LiveTalking Avatar Video Generator
# -------------------------------------------
LIVETALKING_DOMAIN=avatar.lab.home-cloud.uk
