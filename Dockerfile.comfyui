# ---- Base image ----
FROM nvidia/cuda:12.1.1-cudnn8-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
# Prevent ComfyUI-Manager from overriding dependencies
ENV COMFYUI_SKIP_DEP_INSTALL=True

# ---- System dependencies ----
RUN apt-get update && apt-get install -y \
  git \
  python3.10 \
  python3-pip \
  wget \
  curl \
  ffmpeg \
  libgl1-mesa-glx \
  libglib2.0-0 \
  libsm6 \
  libxext6 \
  libxrender-dev \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# ---- Clone ComfyUI ----
RUN git clone https://github.com/comfyanonymous/ComfyUI.git
WORKDIR /app/ComfyUI

# ---- Install PyTorch (CUDA 12.1 compatible) ----
RUN pip3 install --no-cache-dir \
  torch==2.3.1+cu121 \
  torchvision==0.18.1+cu121 \
  torchaudio==2.3.1 \
  --index-url https://download.pytorch.org/whl/cu121

# ---- Install ComfyUI core dependencies ----
RUN pip3 install --no-cache-dir -r requirements.txt

# ---- Install video, audio, and AI packages ----
RUN pip3 install --no-cache-dir \
  av \
  imageio-ffmpeg \
  ffmpeg-python \
  insightface \
  onnxruntime-gpu

# ---- Fix for LatentSyncWrapper (cached_download compatibility) ----
RUN pip3 install --no-cache-dir \
  diffusers==0.27.2 \
  huggingface_hub==0.23.2 \
  transformers==4.41.2 \
  numpy==1.26.4

# ---- Prepare directories ----
RUN mkdir -p /app/ComfyUI/custom_nodes \
  /app/ComfyUI/models \
  /app/ComfyUI/input \
  /app/ComfyUI/output

# ---- Expose port ----
EXPOSE 8188

# ---- Start ComfyUI ----
CMD ["python3", "main.py", "--listen", "0.0.0.0", "--port", "8188"]

